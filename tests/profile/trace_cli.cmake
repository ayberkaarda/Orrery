# Runs orrery_app with --trace and checks the trace file (docs/observability.md).
#   EXE        the executable
#   ARGS       ;-separated arguments (without --trace)
#   TRACE      trace file to write (removed first)
#   ZONES      zone names the trace must contain when the build compiles zones in
#   GL_ZONES   zone names required in addition when the run rendered (exit 0)
# Exit code 3 (no OpenGL 4.6 context) is accepted: the physics ran and the
# trace is still written. Every complete event must carry a name, numeric ts
# and dur, and the totals must agree with the events.
get_filename_component(trace_dir "${TRACE}" DIRECTORY)
file(MAKE_DIRECTORY "${trace_dir}")
file(REMOVE "${TRACE}")
execute_process(COMMAND "${EXE}" ${ARGS} --trace "${TRACE}"
    RESULT_VARIABLE code
    OUTPUT_VARIABLE out
    ERROR_VARIABLE err)
message(STATUS "exit code ${code}\nstdout:\n${out}\nstderr:\n${err}")
if(NOT code STREQUAL "0" AND NOT code STREQUAL "3")
    message(FATAL_ERROR "expected exit code 0 or 3, got ${code}")
endif()
if(NOT EXISTS "${TRACE}")
    message(FATAL_ERROR "no trace written to ${TRACE}")
endif()
file(READ "${TRACE}" text)

macro(json_get out)
    string(JSON ${out} ERROR_VARIABLE json_error GET "${text}" ${ARGN})
    if(json_error)
        message(FATAL_ERROR "trace: ${json_error}")
    endif()
endmacro()

json_get(format otherData format)
json_get(compiled otherData zones_compiled)
json_get(dropped otherData dropped)
if(NOT format STREQUAL "orrery-trace")
    message(FATAL_ERROR "otherData.format is '${format}'")
endif()

# Complete events per name.
string(JSON event_count LENGTH "${text}" traceEvents)
set(names "")
math(EXPR last "${event_count} - 1")
foreach(i RANGE 0 ${last})
    json_get(ph traceEvents ${i} ph)
    if(ph STREQUAL "M")
        continue()
    endif()
    if(NOT ph STREQUAL "X")
        message(FATAL_ERROR "event ${i}: unexpected phase '${ph}'")
    endif()
    json_get(name traceEvents ${i} name)
    foreach(key ts dur)
        string(JSON type TYPE "${text}" traceEvents ${i} ${key})
        if(NOT type STREQUAL "NUMBER")
            message(FATAL_ERROR "event ${i} (${name}): ${key} is ${type}, not a number")
        endif()
    endforeach()
    list(APPEND names "${name}")
endforeach()

string(JSON total_count LENGTH "${text}" zoneTotals)
if(compiled STREQUAL "false")
    if(names OR total_count GREATER 0)
        message(FATAL_ERROR "zones are compiled out but the trace holds zones: ${names}")
    endif()
    message(STATUS "zones compiled out: valid empty trace")
    return()
endif()

set(required ${ZONES})
if(code STREQUAL "0")
    list(APPEND required ${GL_ZONES})
endif()
foreach(zone IN LISTS required)
    if(NOT zone IN_LIST names)
        message(FATAL_ERROR "zone '${zone}' missing from the trace (found: ${names})")
    endif()
endforeach()

# Totals: one entry per name, counts equal to the events when none were dropped.
if(total_count GREATER 0)
    math(EXPR last_total "${total_count} - 1")
    foreach(i RANGE 0 ${last_total})
        json_get(name zoneTotals ${i} name)
        json_get(count zoneTotals ${i} count)
        set(seen ${names})
        list(FILTER seen INCLUDE REGEX "^${name}$")
        list(LENGTH seen events_of_name)
        if(dropped STREQUAL "0" AND NOT count EQUAL events_of_name)
            message(FATAL_ERROR "zoneTotals '${name}': count ${count}, events ${events_of_name}")
        endif()
    endforeach()
endif()
list(REMOVE_DUPLICATES names)
message(STATUS "zones: ${names}")

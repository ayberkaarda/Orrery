#version 460 core
// Marching cubes: one invocation per cell of an nx x ny x nz grid of values
// relative to the iso level (inside: value > 0). The case table (binding 1)
// holds per case a triangle count and the cell edges of each triangle,
// generated by orrery::render::marching_cubes_table. Triangles are appended
// through an atomic counter (binding 2) as { vec4 position[3]; uvec4 edge; }
// with positions in index coordinates; the host orders them.

layout(local_size_x = 8, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) readonly buffer Values {
    float values[];
};
layout(std430, binding = 1) readonly buffer Table {
    uint table[]; // 256 cases x 37 words
};
layout(std430, binding = 2) buffer Counter {
    uint emitted;
};
struct Triangle {
    vec4 position[3];
    uvec4 edge;
};
layout(std430, binding = 3) writeonly buffer Triangles {
    Triangle triangles[];
};

uniform uint u_nx;
uniform uint u_ny;
uniform uint u_nz;
uniform uint u_max_triangles;

const uint kStride = 37u;

uint node_index(uvec3 n) {
    return n.x + u_nx * (n.y + u_ny * n.z);
}

uvec3 corner_offset(uint c) {
    return uvec3(c & 1u, (c >> 1u) & 1u, (c >> 2u) & 1u);
}

// Lower corner and axis of cell edge e (0-3 along x, 4-7 along y, 8-11 z).
void edge_of(uint e, out uint lower, out uint axis) {
    axis = e / 4u;
    uint k = e % 4u;
    if (axis == 0u) {
        lower = 2u * (k & 1u) + 4u * (k >> 1u);
    } else if (axis == 1u) {
        lower = (k & 1u) + 4u * (k >> 1u);
    } else {
        lower = (k & 1u) + 2u * (k >> 1u);
    }
}

void main() {
    uvec3 cell = gl_GlobalInvocationID;
    if (cell.x + 1u >= u_nx || cell.y + 1u >= u_ny || cell.z + 1u >= u_nz) {
        return;
    }
    float corner_value[8];
    uint mask = 0u;
    for (uint c = 0u; c < 8u; ++c) {
        corner_value[c] = values[node_index(cell + corner_offset(c))];
        if (corner_value[c] > 0.0) {
            mask |= 1u << c;
        }
    }
    uint entry = mask * kStride;
    uint count = table[entry];
    for (uint t = 0u; t < count; ++t) {
        uint slot = atomicAdd(emitted, 1u);
        if (slot >= u_max_triangles) {
            continue;
        }
        Triangle tri;
        for (uint v = 0u; v < 3u; ++v) {
            uint e = table[entry + 1u + 3u * t + v];
            uint lower;
            uint axis;
            edge_of(e, lower, axis);
            uint upper = lower | (1u << axis);
            float a = corner_value[lower];
            float b = corner_value[upper];
            float denominator = b - a;
            float f = denominator != 0.0 ? clamp(-a / denominator, 0.0, 1.0) : 0.5;
            uvec3 node = cell + corner_offset(lower);
            vec3 p = vec3(node);
            p[axis] += f;
            tri.position[v] = vec4(p, 1.0);
            tri.edge[v] = 3u * node_index(node) + axis;
        }
        tri.edge.w = 0u;
        triangles[slot] = tri;
    }
}

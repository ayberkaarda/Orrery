# Embeds GLSL sources into a C++ header at build time.
#
# Usage: cmake -DOUTPUT=<header> -DSHADERS=<a.glsl;b.glsl;...>
#              [-DNAMESPACE=<ns>] -P embed_shaders.cmake
#
# Each file <stem>.glsl becomes
#   inline constexpr EmbeddedShader <identifier>{"<stem>.glsl", R"...(...)..."};
# in namespace <ns> (default orrery::render::shaders), where <identifier> is
# the stem with every character outside [A-Za-z0-9_] replaced by '_'.
#
# The source is split into raw string pieces of at most 8000 bytes (MSVC
# limits a single string literal to 16380 bytes; adjacent literals
# concatenate). Pieces end at line boundaries where possible; a line longer
# than the limit is itself cut into pieces of at most 8000 bytes, never inside
# a multi-byte UTF-8 sequence. The concatenated pieces are the source bytes
# exactly. Line endings are normalised to LF so the embedded text is identical
# on every platform. The header is rewritten only when its content changes.

cmake_minimum_required(VERSION 3.28)

if(NOT DEFINED OUTPUT OR NOT DEFINED SHADERS)
    message(FATAL_ERROR "embed_shaders.cmake needs -DOUTPUT=<header> and -DSHADERS=<files>")
endif()
if(NOT DEFINED NAMESPACE)
    set(NAMESPACE "orrery::render::shaders")
endif()
if(NOT NAMESPACE MATCHES "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$")
    message(FATAL_ERROR "embed_shaders: '${NAMESPACE}' is not a C++ namespace name")
endif()

set(delimiter "orrery_glsl")
set(piece_limit 8000)

# Largest cut <= piece_limit at which `text` (longer than piece_limit) can be
# split without separating a UTF-8 lead byte from its continuation bytes
# (10xxxxxx, hex 80-bf). Stops after three steps back: a longer run of
# continuation bytes is not UTF-8, and its bytes are kept unchanged.
function(embed_safe_cut text out)
    set(cut ${piece_limit})
    foreach(step RANGE 1 3)
        string(SUBSTRING "${text}" ${cut} 1 byte)
        string(HEX "${byte}" hex)
        if(NOT hex MATCHES "^[89ab]")
            break()
        endif()
        math(EXPR cut "${cut} - 1")
    endforeach()
    set(${out} ${cut} PARENT_SCOPE)
endfunction()

set(body "")
set(table "")
set(identifiers "")
list(SORT SHADERS)
foreach(shader IN LISTS SHADERS)
    get_filename_component(file_name "${shader}" NAME)
    string(REGEX REPLACE "\\.glsl$" "" stem "${file_name}")
    string(MAKE_C_IDENTIFIER "${stem}" identifier)
    if(identifier IN_LIST identifiers)
        message(FATAL_ERROR "embed_shaders: two shaders map to the identifier '${identifier}'")
    endif()
    list(APPEND identifiers "${identifier}")

    file(READ "${shader}" source)
    string(REPLACE "\r\n" "\n" source "${source}")
    string(FIND "${source}" ")${delimiter}\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "embed_shaders: ${file_name} contains the raw string delimiter")
    endif()

    # Split into pieces at line boundaries. A semicolon in the source would
    # split a CMake list, so lines are collected with string(FIND) instead.
    # string(LENGTH) and string(SUBSTRING) count bytes.
    set(pieces "")
    set(piece "")
    set(rest "${source}")
    while(NOT rest STREQUAL "")
        string(FIND "${rest}" "\n" newline)
        if(newline EQUAL -1)
            set(line "${rest}")
            set(rest "")
        else()
            math(EXPR take "${newline} + 1")
            string(SUBSTRING "${rest}" 0 ${take} line)
            string(SUBSTRING "${rest}" ${take} -1 rest)
        endif()
        string(LENGTH "${piece}" piece_length)
        string(LENGTH "${line}" line_length)
        math(EXPR combined "${piece_length} + ${line_length}")
        if(combined GREATER piece_limit AND piece_length GREATER 0)
            string(APPEND pieces "    R\"${delimiter}(${piece})${delimiter}\"\n")
            set(piece "")
        endif()
        # A line longer than the limit is cut into pieces of its own.
        while(line_length GREATER piece_limit)
            embed_safe_cut("${line}" cut)
            string(SUBSTRING "${line}" 0 ${cut} head)
            string(SUBSTRING "${line}" ${cut} -1 line)
            string(APPEND pieces "    R\"${delimiter}(${head})${delimiter}\"\n")
            string(LENGTH "${line}" line_length)
        endwhile()
        string(APPEND piece "${line}")
    endwhile()
    string(APPEND pieces "    R\"${delimiter}(${piece})${delimiter}\"")

    string(APPEND body
        "// ${file_name}\n"
        "inline constexpr EmbeddedShader ${identifier}{\n"
        "    \"${file_name}\",\n"
        "${pieces}};\n\n")
    string(APPEND table "    &${identifier},\n")
endforeach()

list(LENGTH identifiers count)
set(header
"// Generated by src/render/cmake/embed_shaders.cmake from src/render/shaders/*.glsl.
// Do not edit; edit the .glsl files instead.
#pragma once

#include <array>
#include <string_view>

namespace ${NAMESPACE} {

struct EmbeddedShader {
    std::string_view name;
    std::string_view source;
};

${body}// Every embedded shader, sorted by file name.
inline constexpr std::array<const EmbeddedShader*, ${count}> all{
${table}};

} // namespace ${NAMESPACE}
")

set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL header)
    file(WRITE "${OUTPUT}" "${header}")
endif()

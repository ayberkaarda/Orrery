{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "orrery",
  "version-semver": "0.1.0",
  "description": "Physics laboratory: space dynamics, aerodynamics and atmospheric entry.",
  "builtin-baseline": "2ec0f1747d8186a5c9babe276e2ad57cd2b12d2a",
  "dependencies": [
    "assimp",
    "catch2",
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "openssl"
      ]
    },
    {
      "name": "glad",
      "features": [
        "gl-api-46"
      ]
    },
    "eigen3",
    "glfw3",
    "glm",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "glfw-binding",
        "opengl3-binding"
      ]
    },
    "implot",
    "miniz",
    "nlohmann-json",
    "openssl",
    "tbb",
    "tomlplusplus"
  ],
  "features": {
    "profiling": {
      "description": "Tracy profiler client for ORRERY_TRACY builds (not used by the default or CI presets)",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        }
      ]
    }
  }
}
